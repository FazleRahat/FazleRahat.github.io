---
import { formatEducationPeriod } from '../lib/dates';
import type { Education } from '../lib/schemas';

type Props = {
  records: Education[];
  headingLevel?: 'h3' | 'h4';
};

const { records, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ol class="timeline">
  {
    records.map((record) => (
      <li class="timeline-item role" id={record.id}>
        <p class="overline period">{formatEducationPeriod(record.start, record.end, record.expectedEnd)}</p>
        <Heading class="role-title">{record.degree}</Heading>
        <p class="org">
          {record.institution}, {record.location}
        </p>
        {record.thesis && (
          <p class="thesis">
            <span class="thesis-label">{record.thesis.label}:</span> {record.thesis.title}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .role-title {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: var(--space-1);
  }

  .period {
    letter-spacing: 0.06em;
  }

  .org {
    margin-top: var(--space-1);
  }

  .thesis {
    margin-top: var(--space-2);
    max-width: var(--measure);
    font-size: 1rem;
    line-height: 1.65;
  }

  .thesis-label {
    font-weight: 600;
  }
</style>
