---
type Props = { name: string; /** Rendered size in px. */ size?: number };
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'personal' && <><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></>}
  {name === 'school' && <><path d="m3 8 9-5 9 5M4 8h16v13H4V8ZM8 11v2M12 11v2M16 11v2M8 16v2M16 16v2M11 21v-5h2v5"/></>}
  {/* Profile links are solid, frameless marks (no outline box); the contact icons above stay outlined. */}
  {name === 'location' && <><path d="M12 21.5s-7-6.1-7-11.7a7 7 0 0 1 14 0c0 5.6-7 11.7-7 11.7Z"/><circle cx="12" cy="9.8" r="2.6"/></>}
  {name === 'email' && <><path fill="currentColor" stroke="none" d="M2.2 6.1A1 1 0 0 1 3 5h18a1 1 0 0 1 .8 1.1L12 12.3 2.2 6.1ZM2 8.2l10 6.4 10-6.4V18a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.2Z"/></>}
  {name === 'Google Scholar' && <><path fill="currentColor" stroke="none" d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3ZM5 13.2v4L12 21l7-3.8v-4L12 17l-7-3.8Z"/></>}
  {name === 'LinkedIn' && <><circle fill="currentColor" stroke="none" cx="4.9" cy="4.9" r="2.4"/><rect fill="currentColor" stroke="none" x="2.8" y="9.3" width="4.2" height="11.7"/><path fill="currentColor" stroke="none" d="M9.8 9.3H14v1.7c.7-1.2 2.1-2 3.9-2 3.5 0 3.9 2.4 3.9 5.2V21h-4.4v-6.1c0-1.4-.2-2.6-1.8-2.6-1.4 0-1.6 1-1.6 2.6V21H9.8V9.3Z"/></>}
  {name === 'CV' && <><path fill="currentColor" stroke="none" fill-rule="evenodd" d="M6 2h7.2L20 8.8V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM8 12h8v1.7H8ZM8 15.8h5.5v1.7H8Z"/></>}
  {!['personal', 'school', 'location', 'email', 'Google Scholar', 'LinkedIn', 'CV'].includes(name) && <><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2"/></>}
</svg>
