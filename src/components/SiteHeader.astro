---
import { getEvents, profile, site } from '../lib/content';
import { routeOf } from '../lib/urls';
import { siteBase, withBase } from '../lib/site';

const route = routeOf(Astro.url.pathname, siteBase);
// Items that need content (the events page) stay out of the navigation until it exists.
const hasEvents = (await getEvents()).length > 0;
const items = site.nav
  .filter((item) => item.requires !== 'events' || hasEvents)
  .map((item) => ({
    ...item,
    href: withBase(item.href),
    // A section's child routes keep it active.
    current: route === item.href || route.startsWith(item.match),
  }));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>{profile.displayName}</a>
    <nav aria-label="Primary">
      <ul class="nav-inline">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="nav-menu">
        <summary>Menu</summary>
        <ul>
          {
            items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }

  .brand {
    padding-block: var(--space-2);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
  }

  li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  li a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  /* Narrow screens: a native disclosure. Works without JavaScript. */
  .nav-inline {
    display: none;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-control);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--transition);
  }

  details[open] summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }

  .nav-menu ul {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 20;
    padding: var(--space-2) max(var(--gutter), (100% - 800px) / 2) var(--space-4);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-menu li + li {
    border-top: 1px solid var(--color-border);
  }

  .nav-menu li a {
    width: 100%;
    min-height: 48px;
    padding-inline: 0;
    font-size: 1rem;
  }

  /* Wide screens: inline navigation. */
  @media (min-width: 60em) {
    .header-inner {
      min-height: 60px;
    }

    .nav-menu {
      display: none;
    }

    .nav-inline {
      display: flex;
      gap: var(--space-1);
    }
  }
</style>
